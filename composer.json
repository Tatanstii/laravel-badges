{
    "name": "insynnia/laravel-badges",
    "description": "Badge, trigger and award engine for Laravel. Award badges to entities via named triggers or manually — idempotent and framework-native.",
    "keywords": ["laravel", "badges", "gamification", "achievements", "triggers", "rewards"],
    "license": "MIT",
    "authors": [
        {
            "name": "Insynnia"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Insynnia\\Badges\\": "src/",
            "Insynnia\\Badges\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Insynnia\\Badges\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Insynnia\\Badges\\BadgesServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
